network unknown {
}
variable DorMuscular {
    type discrete [ 2 ] { Não, Sim };
}
variable Exposicao {
    type discrete [ 2 ] { Não, Sim };
}
variable Febre {
    type discrete [ 2 ] { Não, Sim };
}
variable Gripe {
    type discrete [ 2 ] { Não, Sim };
}
variable Tosse {
    type discrete [ 2 ] { Não, Sim };
}
probability ( DorMuscular | Gripe ) {
    ( Não ) 0.8, 0.2;
    ( Sim ) 0.25, 0.75;

}
probability ( Exposicao ) {
    table 0.8, 0.2 ;
}
probability ( Febre | Gripe ) {
    ( Não ) 0.85, 0.15;
    ( Sim ) 0.15, 0.85;

}
probability ( Gripe | Exposicao ) {
    ( Não ) 0.95, 0.05;
    ( Sim ) 0.7, 0.3;

}
probability ( Tosse | Gripe ) {
    ( Não ) 0.65, 0.35;
    ( Sim ) 0.2, 0.8;

}
