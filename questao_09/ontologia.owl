<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://example.org/ia/2026.2/livros.owl"
         xmlns="https://example.org/ia/2026.2/livros.owl#">

<owl:Ontology rdf:about="https://example.org/ia/2026.2/livros.owl"/>

<owl:ObjectProperty rdf:about="#temAutor">
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="#Autor"/>
  <owl:inverseOf rdf:resource="#autorDe"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#autorDe">
  <rdfs:domain rdf:resource="#Autor"/>
  <rdfs:range rdf:resource="#Livro"/>
  <owl:inverseOf rdf:resource="#temAutor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#abordaTema">
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="#Tema"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temNivel">
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="#Nivel"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temFormato">
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="#Formato"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#publicadoPor">
  <rdfs:domain rdf:resource="#Publicacao"/>
  <rdfs:range rdf:resource="#Editora"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prefereTema">
  <rdfs:domain rdf:resource="#Leitor"/>
  <rdfs:range rdf:resource="#Tema"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prefereNivel">
  <rdfs:domain rdf:resource="#Leitor"/>
  <rdfs:range rdf:resource="#Nivel"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prefereFormato">
  <rdfs:domain rdf:resource="#Leitor"/>
  <rdfs:range rdf:resource="#Formato"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#subTemaDe">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Tema"/>
  <rdfs:range rdf:resource="#Tema"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#relacionadoA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Tema"/>
  <rdfs:range rdf:resource="#Tema"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#titulo">
  <rdfs:domain rdf:resource="#Publicacao"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nome">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Autor"/>
        <rdf:Description rdf:about="#Leitor"/>
        <rdf:Description rdf:about="#Tema"/>
        <rdf:Description rdf:about="#Nivel"/>
        <rdf:Description rdf:about="#Formato"/>
        <rdf:Description rdf:about="#Editora"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#anoPublicacao">
  <rdfs:domain rdf:resource="#Publicacao"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#idioma">
  <rdfs:domain rdf:resource="#Publicacao"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#numeroPaginas">
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#isbn">
  <rdfs:domain rdf:resource="#Livro"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#descricao">
  <rdfs:domain rdf:resource="#Publicacao"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Publicacao">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Livro">
  <rdfs:subClassOf rdf:resource="#Publicacao"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#temFormato"/>
      <owl:someValuesFrom rdf:resource="#Formato"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#temAutor"/>
      <owl:someValuesFrom rdf:resource="#Autor"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#abordaTema"/>
      <owl:someValuesFrom rdf:resource="#Tema"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#publicadoPor"/>
      <owl:someValuesFrom rdf:resource="#Editora"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#temNivel"/>
      <owl:someValuesFrom rdf:resource="#Nivel"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#LivroTecnico">
  <rdfs:subClassOf rdf:resource="#Livro"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Livro"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#abordaTema"/>
          <owl:someValuesFrom rdf:resource="#TemaComputacao"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <owl:disjointWith rdf:resource="#LivroFiccao"/>
</owl:Class>

<owl:Class rdf:about="#LivroFiccao">
  <rdfs:subClassOf rdf:resource="#Livro"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Livro"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#abordaTema"/>
          <owl:someValuesFrom rdf:resource="#TemaLiteratura"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#LivroIntrodutorio">
  <rdfs:subClassOf rdf:resource="#Livro"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Livro"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temNivel"/>
          <owl:someValuesFrom rdf:resource="#NivelBasico"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#LivroAvancado">
  <rdfs:subClassOf rdf:resource="#Livro"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Livro"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temNivel"/>
          <owl:someValuesFrom rdf:resource="#NivelAvancado"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#LivroDigital">
  <rdfs:subClassOf rdf:resource="#Livro"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Livro"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temFormato"/>
          <owl:someValuesFrom rdf:resource="#FormatoDigital"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#LivroFisico">
  <rdfs:subClassOf rdf:resource="#Livro"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Livro"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temFormato"/>
          <owl:someValuesFrom rdf:resource="#FormatoFisico"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#LivroIA">
  <rdfs:subClassOf rdf:resource="#LivroTecnico"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Livro"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#abordaTema"/>
          <owl:someValuesFrom rdf:resource="#TemaIA"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#LivroIntrodutorioIA">
  <rdfs:subClassOf rdf:resource="#LivroIA"/>
  <rdfs:subClassOf rdf:resource="#LivroIntrodutorio"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#LivroIA"/>
        <rdf:Description rdf:about="#LivroIntrodutorio"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Autor">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Leitor">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Tema">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#TemaComputacao">
  <rdfs:subClassOf rdf:resource="#Tema"/>
  <owl:disjointWith rdf:resource="#TemaLiteratura"/>
</owl:Class>

<owl:Class rdf:about="#TemaIA">
  <rdfs:subClassOf rdf:resource="#TemaComputacao"/>
</owl:Class>

<owl:Class rdf:about="#TemaProgramacao">
  <rdfs:subClassOf rdf:resource="#TemaComputacao"/>
</owl:Class>

<owl:Class rdf:about="#TemaLiteratura">
  <rdfs:subClassOf rdf:resource="#Tema"/>
</owl:Class>

<owl:Class rdf:about="#Nivel">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#NivelBasico">
  <rdfs:subClassOf rdf:resource="#Nivel"/>
  <owl:disjointWith rdf:resource="#NivelAvancado"/>
</owl:Class>

<owl:Class rdf:about="#NivelAvancado">
  <rdfs:subClassOf rdf:resource="#Nivel"/>
</owl:Class>

<owl:Class rdf:about="#Formato">
