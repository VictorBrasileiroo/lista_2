<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://example.org/ia/2026.2/projetos.owl"
         xmlns="https://example.org/ia/2026.2/projetos.owl#">

<owl:Ontology rdf:about="https://example.org/ia/2026.2/projetos.owl">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cenário inteiramente fictício para a Questão 15. Os estados dos projetos referem-se a um único instante.</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#participaDe">
  <rdfs:domain rdf:resource="#Estudante"/>
  <rdfs:range rdf:resource="#Projeto"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temArea">
  <rdfs:domain rdf:resource="#Projeto"/>
  <rdfs:range rdf:resource="#AreaConhecimento"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#orientadoPor">
  <rdfs:domain rdf:resource="#Projeto"/>
  <rdfs:range rdf:resource="#Professor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#subAreaDe">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#AreaConhecimento"/>
  <rdfs:range rdf:resource="#AreaConhecimento"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#nome">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Pessoa"/>
        <rdf:Description rdf:about="#AreaConhecimento"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#titulo">
  <rdfs:domain rdf:resource="#Projeto"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Pessoa">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Estudante">
  <rdfs:subClassOf rdf:resource="#Pessoa"/>
</owl:Class>

<owl:Class rdf:about="#EstudantePesquisador">
  <rdfs:subClassOf rdf:resource="#Estudante"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Estudante"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#participaDe"/>
          <owl:someValuesFrom rdf:resource="#ProjetoPesquisa"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#EstudantePesquisadorIA">
  <rdfs:subClassOf rdf:resource="#EstudantePesquisador"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Estudante"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#participaDe"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#ProjetoPesquisa"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#temArea"/>
                  <owl:someValuesFrom rdf:resource="#AreaIA"/>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Professor">
  <rdfs:subClassOf rdf:resource="#Pessoa"/>
</owl:Class>

<owl:Class rdf:about="#Projeto">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ProjetoPesquisa">
  <rdfs:subClassOf rdf:resource="#Projeto"/>
</owl:Class>

<owl:Class rdf:about="#ProjetoExtensao">
  <rdfs:subClassOf rdf:resource="#Projeto"/>
</owl:Class>

<owl:Class rdf:about="#ProjetoAtivo">
  <rdfs:subClassOf rdf:resource="#Projeto"/>
  <owl:disjointWith rdf:resource="#ProjetoEncerrado"/>
</owl:Class>

<owl:Class rdf:about="#ProjetoEncerrado">
  <rdfs:subClassOf rdf:resource="#Projeto"/>
</owl:Class>

<owl:Class rdf:about="#AreaConhecimento">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#AreaComputacao">
  <rdfs:subClassOf rdf:resource="#AreaConhecimento"/>
</owl:Class>

<owl:Class rdf:about="#AreaIA">
  <rdfs:subClassOf rdf:resource="#AreaComputacao"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#computacao">
  <rdf:type rdf:resource="#AreaComputacao"/>
  <nome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Computação</nome>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ia">
  <rdf:type rdf:resource="#AreaIA"/>
  <subAreaDe rdf:resource="#computacao"/>
  <nome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inteligência artificial</nome>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#pln">
  <rdf:type rdf:resource="#AreaIA"/>
  <subAreaDe rdf:resource="#ia"/>
  <nome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Processamento de linguagem natural</nome>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#professor_alex">
  <rdf:type rdf:resource="#Professor"/>
  <nome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alex, perfil fictício</nome>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#projeto_ia">
  <rdf:type rdf:resource="#ProjetoPesquisa"/>
  <temArea rdf:resource="#ia"/>
  <orientadoPor rdf:resource="#professor_alex"/>
  <rdf:type rdf:resource="#ProjetoAtivo"/>
  <titulo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pesquisa de agentes inteligentes</titulo>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#projeto_redes">
  <rdf:type rdf:resource="#ProjetoPesquisa"/>
  <temArea rdf:resource="#computacao"/>
  <orientadoPor rdf:resource="#professor_alex"/>
  <rdf:type rdf:resource="#ProjetoAtivo"/>
  <titulo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pesquisa de redes universitárias</titulo>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#projeto_extensao">
  <rdf:type rdf:resource="#ProjetoExtensao"/>
  <temArea rdf:resource="#computacao"/>
  <orientadoPor rdf:resource="#professor_alex"/>
  <rdf:type rdf:resource="#ProjetoAtivo"/>
  <titulo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oficinas de inclusão digital</titulo>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#estudante_ana">
  <rdf:type rdf:resource="#Estudante"/>
  <participaDe rdf:resource="#projeto_ia"/>
  <nome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ana, perfil fictício</nome>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#estudante_bruno">
  <rdf:type rdf:resource="#Estudante"/>
  <participaDe rdf:resource="#projeto_redes"/>
  <nome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bruno, perfil fictício</nome>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#estudante_clara">
  <rdf:type rdf:resource="#Estudante"/>
  <participaDe rdf:resource="#projeto_extensao"/>
  <nome rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clara, perfil fictício</nome>
</owl:NamedIndividual>


</rdf:RDF>
